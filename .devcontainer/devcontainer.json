{
  "name": "Go + Claude Secure Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "remoteUser": "claude",
  "overrideCommand": false,

  "mounts": [
    "source=tusk-devcontainer-claude-home,target=/home/claude/.claude,type=volume",
    "source=tusk-devcontainer-go-cache,target=/home/claude/.gocache,type=volume"
  ],

  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=CHOWN",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=no-new-privileges:true"
  ],

  "containerEnv": {
    "GO111MODULE": "on",
    "GOPROXY": "https://proxy.golang.org,direct",
    "CGO_ENABLED": "0",
    "GOCACHE": "/home/claude/.gocache/build",
    "GOMODCACHE": "/home/claude/.gocache/mod",
    "HTTP_PROXY": "http://127.0.0.1:8888",
    "HTTPS_PROXY": "http://127.0.0.1:8888",
    "NO_PROXY": "localhost,127.0.0.1"
  },

  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
