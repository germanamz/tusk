// Tusk development layout. Launch with: `zellij --layout tusk`.
//
// Panes:
//   - editor (top, 50%): nvim
//   - claude (bottom left): claude-code CLI with permission prompts
//     bypassed — the devcontainer itself is the sandbox (egress firewall +
//     tinyproxy allowlist + no-sudo vscode user), so prompt-level gates add
//     friction without adding safety.
//   - tusk shell (bottom right): interactive bash for running `tusk task tree`,
//     `tusk task create`, etc. on demand

layout {
    pane split_direction="horizontal" {
        pane size="50%" name="editor" {
            command "nvim"
            args "."
        }
        pane split_direction="vertical" {
            pane size="50%" name="claude" {
                command "claude"
                args "--dangerously-skip-permissions"
            }
            pane size="50%" name="tusk" {
                command "zsh"
            }
        }
    }
}
